<?xml version="1.0" encoding="UTF-8"?>
<!--
  这是模板,给人看结构用的(会进 git)。
  真的那份复制成仓库根目录的 Secrets.plist(和本文件同级,已被 .gitignore 忽略)。

  ⚠️ 不要放进 Slime/ 文件夹 —— 那里的所有文件都会被自动打进 App,IPA 解压就能读到。
  App 本身不读这个文件:它只跟中转(relay/)说话,一个密钥都不带。

  DeepSeekAPIKey  —— 只在部署中转时用一次:喂给 `npx wrangler secret put DEEPSEEK_API_KEY`
  RelayDevToken   —— 开发者通行证。中转那边设成同一个值(DEV_TOKEN);
                     eval 测试从这里读(见 SlimeTests/EvalClient.swift),带上它不被限流。
                     生成:openssl rand -hex 32
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>DeepSeekAPIKey</key>
	<string></string>
	<key>RelayDevToken</key>
	<string></string>
</dict>
</plist>
